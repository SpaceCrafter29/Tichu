rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Feste uids mit Admin-Rechten (jeden Sitz kicken, jeden Tisch anlegen/löschen - siehe
    // lib/lobby.js: ADMIN_UIDS/isAdminUid()). Bewusst eine feste Liste statt eines Felds in
    // Firestore, damit niemand sich selbst per Schreibzugriff zum Admin machen kann.
    function isAdmin() {
      return signedIn() && request.auth.uid in ['HNaYIyZ44qgLwWF12XRyA6jQRjM2'];
    }

    // Hat `request.auth.uid` irgendeinen der vier Sitzplätze dieses Tisches beansprucht?
    // (Ohne diese Prüfung könnte jeder beliebige angemeldete Nutzer fremde Tische verändern.)
    function isParticipant(gameId) {
      return
        (exists(/databases/$(database)/documents/games/$(gameId)/private/seat0)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat0).data.claimedByUid == request.auth.uid)
        || (exists(/databases/$(database)/documents/games/$(gameId)/private/seat1)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat1).data.claimedByUid == request.auth.uid)
        || (exists(/databases/$(database)/documents/games/$(gameId)/private/seat2)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat2).data.claimedByUid == request.auth.uid)
        || (exists(/databases/$(database)/documents/games/$(gameId)/private/seat3)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat3).data.claimedByUid == request.auth.uid);
    }

    // Eigenes Profil (Anzeigename etc.) - ausschließlich für den Besitzer sichtbar.
    // Innerhalb eines laufenden Spiels wird dieser Name NICHT angezeigt (siehe games/*).
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Sitzplätze dürfen beim Beitreten nur von null auf belegt wechseln - nie umgekehrt und nie
    // ein bereits belegter Platz überschrieben werden. Damit kommt das Beitreten ohne isParticipant()
    // aus: exists()/get() in Regeln sehen die eigene, noch nicht committete Transaktion nicht, ein
    // frisch beitretender Spieler wäre also nie "Teilnehmer genug", um sein eigenes Update freizugeben.
    function seatsOnlyGrow(before, after) {
      return (before[0] == null || before[0] == after[0])
        && (before[1] == null || before[1] == after[1])
        && (before[2] == null || before[2] == after[2])
        && (before[3] == null || before[3] == after[3]);
    }

    // Verlassen: genau der eigene, belegte Sitz wird wieder frei (null), alle anderen bleiben
    // exakt gleich. "Eigen" heißt: die private Handkarten-Doku dieses Sitzes war (VOR dieser
    // Transaktion - siehe Kommentar zu exists()/get() oben) auf die eigene uid angemeldet.
    function isMySeatCleared(gameId, before, after) {
      return
        (before[0] != null && after[0] == null && before[1] == after[1] && before[2] == after[2] && before[3] == after[3]
          && exists(/databases/$(database)/documents/games/$(gameId)/private/seat0)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat0).data.claimedByUid == request.auth.uid)
        || (before[1] != null && after[1] == null && before[0] == after[0] && before[2] == after[2] && before[3] == after[3]
          && exists(/databases/$(database)/documents/games/$(gameId)/private/seat1)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat1).data.claimedByUid == request.auth.uid)
        || (before[2] != null && after[2] == null && before[0] == after[0] && before[1] == after[1] && before[3] == after[3]
          && exists(/databases/$(database)/documents/games/$(gameId)/private/seat2)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat2).data.claimedByUid == request.auth.uid)
        || (before[3] != null && after[3] == null && before[0] == after[0] && before[1] == after[1] && before[2] == after[2]
          && exists(/databases/$(database)/documents/games/$(gameId)/private/seat3)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat3).data.claimedByUid == request.auth.uid);
    }

    // Tisch-Reset: alle vier Sitze auf einmal räumen. Für einen bereits (teil-)ausgeteilten
    // Tisch, den jemand verlässt - ein einzelner Nachrücker könnte mit den alten Händen der
    // übrigen drei nichts anfangen, siehe leaveTable() in lobby.js.
    function isFullReset(seats) {
      return seats[0] == null && seats[1] == null && seats[2] == null && seats[3] == null;
    }

    // Lobby-Inaktivität: ein Mitspieler an einem NOCH WARTENDEN Tisch darf einen anderen,
    // seit über 90s nicht mehr "geheartbeateten" Sitz räumen (siehe heartbeat()/checkStaleSeats()
    // in lib/room.js) - sonst blockiert eine abwesende Person den Tisch auf unbestimmte Zeit.
    // Exakt dieselbe Form wie isMySeatCleared() oben, nur mit einer Zeit- statt einer
    // Besitz-Prüfung.
    function isStaleSeatCleared(gameId, before, after) {
      return
        (before[0] != null && after[0] == null && before[1] == after[1] && before[2] == after[2] && before[3] == after[3]
          && exists(/databases/$(database)/documents/games/$(gameId)/private/seat0)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat0).data.lastActive < request.time - duration.value(90, 's'))
        || (before[1] != null && after[1] == null && before[0] == after[0] && before[2] == after[2] && before[3] == after[3]
          && exists(/databases/$(database)/documents/games/$(gameId)/private/seat1)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat1).data.lastActive < request.time - duration.value(90, 's'))
        || (before[2] != null && after[2] == null && before[0] == after[0] && before[1] == after[1] && before[3] == after[3]
          && exists(/databases/$(database)/documents/games/$(gameId)/private/seat2)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat2).data.lastActive < request.time - duration.value(90, 's'))
        || (before[3] != null && after[3] == null && before[0] == after[0] && before[1] == after[1] && before[2] == after[2]
          && exists(/databases/$(database)/documents/games/$(gameId)/private/seat3)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat3).data.lastActive < request.time - duration.value(90, 's'));
    }

    match /games/{gameId} {
      // Öffentlicher Spielstand (Sitz-Tokens, Stiche, Punkte, wer am Zug ist) - enthält
      // absichtlich keine uids/Anzeigenamen, ist also für alle angemeldeten Nutzer unbedenklich.
      allow read: if signedIn();
      allow create: if signedIn();
      // Entweder: normales Beitreten (nur freie Sitze füllen, kein Überschreiben - kein
      // "isParticipant darf alles"-Fallback, sonst könnte jeder Teilnehmer per direktem
      // Firestore-Schreibzugriff fremde Sitze überschreiben). Oder: der eigene Sitz wird
      // wieder freigegeben (Verlassen, siehe leaveTable() in lobby.js).
      allow update: if signedIn()
        && (
          isAdmin()
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats', 'status'])
            && (
              seatsOnlyGrow(resource.data.seats, request.resource.data.seats)
              || (isMySeatCleared(gameId, resource.data.seats, request.resource.data.seats)
                && request.resource.data.status == 'waiting')
              || (isParticipant(gameId)
                && isFullReset(request.resource.data.seats)
                && request.resource.data.status == 'waiting')
              || (isParticipant(gameId)
                && resource.data.status == 'waiting'
                && request.resource.data.status == 'waiting'
                && isStaleSeatCleared(gameId, resource.data.seats, request.resource.data.seats))
            ))
        );
      // Löschen: normalerweise nur leere Tische (kein belegter Sitz) - kann also nie echte
      // Spieldaten wegwerfen, ist aber genug, um verwaiste/Test-Tische aufzuräumen. Admins
      // dürfen zusätzlich jeden Tisch löschen (siehe isAdmin() oben).
      allow delete: if signedIn() && (isFullReset(resource.data.seats) || isAdmin());

      // Die Hand jedes Sitzes: die eigene uid, oder ein Mitspieler an diesem Tisch (bewusste
      // Vereinfachung fürs Online-Spielbrett - Schupfen/Züge laufen über ein für alle
      // Teilnehmer sichtbares Ereignis-Log, siehe events unten; echte Geheimhaltung bräuchte
      // pro-Empfänger-Postfächer, was für den aktuellen Umfang zu viel Aufwand ist).
      match /private/{seatDoc} {
        allow read: if signedIn()
          && (resource.data.claimedByUid == request.auth.uid || isParticipant(gameId));

        // Sitz beanspruchen: nur als sich selbst, mit leerer Starthand (Plätze 1-3) oder direkt
        // mit den ersten 8 Karten + den zurückgehaltenen restlichen 6 (der vierte Spieler
        // mischt und legt seine eigene Hand im selben Zug an, siehe joinTable() in lobby.js;
        // die 6 restlichen Karten kommen erst nach der Großen-Tichu-Entscheidung über
        // `newRound`-Ereignisse dazu, nicht mehr über dieses Dokument).
        allow create: if signedIn()
          && request.resource.data.claimedByUid == request.auth.uid
          && (request.resource.data.hand.size() == 0 || request.resource.data.hand.size() == 8)
          && (request.resource.data.restHand.size() == 0 || request.resource.data.restHand.size() == 6);

        allow update: if signedIn() && (
          // eigene Hand fortlaufend aktualisieren (z. B. beim Ausspielen von Karten)
          resource.data.claimedByUid == request.auth.uid
          ||
          // einmaliges Austeilen durch den Mitspieler, der den vierten Sitz füllt: darf nur
          // `hand`/`restHand` setzen, und nur solange die Hand noch leer (also nicht
          // ausgeteilt) ist. (Kein isParticipant()-Check hier, aus demselben
          // Transaktions-Sichtbarkeitsgrund wie oben - Restrisiko ist dokumentiert in der
          // README.)
          (resource.data.hand.size() == 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hand', 'restHand']))
        );

        // Verlassen: die eigene private Hand darf immer gelöscht werden. Beim Tisch-Reset
        // (siehe isFullReset oben) darf ein Teilnehmer auch die private Hand der anderen drei
        // löschen - sonst blieben deren Handkarten-Dokumente nicht-leer und blockierten einen
        // künftigen Beitritt (siehe Kommentar bei leaveTable() in lobby.js). Admins dürfen
        // zusätzlich jede private Hand löschen (siehe isAdmin() oben).
        allow delete: if signedIn()
          && (resource.data.claimedByUid == request.auth.uid || isParticipant(gameId) || isAdmin());
      }

      // Ereignis-Log der gespielten Züge (einmal gespielte Karten sind ohnehin öffentlich).
      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn() && isParticipant(gameId);
        allow update, delete: if false;
      }
    }
  }
}
