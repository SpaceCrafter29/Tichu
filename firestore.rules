rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Hat `request.auth.uid` irgendeinen der vier Sitzplätze dieses Tisches beansprucht?
    // (Ohne diese Prüfung könnte jeder beliebige angemeldete Nutzer fremde Tische verändern.)
    function isParticipant(gameId) {
      return
        (exists(/databases/$(database)/documents/games/$(gameId)/private/seat0)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat0).data.claimedByUid == request.auth.uid)
        || (exists(/databases/$(database)/documents/games/$(gameId)/private/seat1)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat1).data.claimedByUid == request.auth.uid)
        || (exists(/databases/$(database)/documents/games/$(gameId)/private/seat2)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat2).data.claimedByUid == request.auth.uid)
        || (exists(/databases/$(database)/documents/games/$(gameId)/private/seat3)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat3).data.claimedByUid == request.auth.uid);
    }

    // Eigenes Profil (Anzeigename etc.) - ausschließlich für den Besitzer sichtbar.
    // Innerhalb eines laufenden Spiels wird dieser Name NICHT angezeigt (siehe games/*).
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Sitzplätze dürfen beim Beitreten nur von null auf belegt wechseln - nie umgekehrt und nie
    // ein bereits belegter Platz überschrieben werden. Damit kommt das Beitreten ohne isParticipant()
    // aus: exists()/get() in Regeln sehen die eigene, noch nicht committete Transaktion nicht, ein
    // frisch beitretender Spieler wäre also nie "Teilnehmer genug", um sein eigenes Update freizugeben.
    function seatsOnlyGrow(before, after) {
      return (before[0] == null || before[0] == after[0])
        && (before[1] == null || before[1] == after[1])
        && (before[2] == null || before[2] == after[2])
        && (before[3] == null || before[3] == after[3]);
    }

    // Verlassen: genau der eigene, belegte Sitz wird wieder frei (null), alle anderen bleiben
    // exakt gleich. "Eigen" heißt: die private Handkarten-Doku dieses Sitzes war (VOR dieser
    // Transaktion - siehe Kommentar zu exists()/get() oben) auf die eigene uid angemeldet.
    function isMySeatCleared(gameId, before, after) {
      return
        (before[0] != null && after[0] == null && before[1] == after[1] && before[2] == after[2] && before[3] == after[3]
          && exists(/databases/$(database)/documents/games/$(gameId)/private/seat0)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat0).data.claimedByUid == request.auth.uid)
        || (before[1] != null && after[1] == null && before[0] == after[0] && before[2] == after[2] && before[3] == after[3]
          && exists(/databases/$(database)/documents/games/$(gameId)/private/seat1)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat1).data.claimedByUid == request.auth.uid)
        || (before[2] != null && after[2] == null && before[0] == after[0] && before[1] == after[1] && before[3] == after[3]
          && exists(/databases/$(database)/documents/games/$(gameId)/private/seat2)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat2).data.claimedByUid == request.auth.uid)
        || (before[3] != null && after[3] == null && before[0] == after[0] && before[1] == after[1] && before[2] == after[2]
          && exists(/databases/$(database)/documents/games/$(gameId)/private/seat3)
          && get(/databases/$(database)/documents/games/$(gameId)/private/seat3).data.claimedByUid == request.auth.uid);
    }

    match /games/{gameId} {
      // Öffentlicher Spielstand (Sitz-Tokens, Stiche, Punkte, wer am Zug ist) - enthält
      // absichtlich keine uids/Anzeigenamen, ist also für alle angemeldeten Nutzer unbedenklich.
      allow read: if signedIn();
      allow create: if signedIn();
      // Entweder: normales Beitreten (nur freie Sitze füllen, kein Überschreiben - kein
      // "isParticipant darf alles"-Fallback, sonst könnte jeder Teilnehmer per direktem
      // Firestore-Schreibzugriff fremde Sitze überschreiben). Oder: der eigene Sitz wird
      // wieder freigegeben (Verlassen, siehe leaveTable() in lobby.js).
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats', 'status'])
        && (
          seatsOnlyGrow(resource.data.seats, request.resource.data.seats)
          || (isMySeatCleared(gameId, resource.data.seats, request.resource.data.seats)
            && request.resource.data.status == 'waiting')
        );
      allow delete: if false;

      // Die Hand jedes Sitzes: nur die uid, die den Sitz beansprucht hat, darf sie lesen.
      match /private/{seatDoc} {
        allow read: if signedIn() && resource.data.claimedByUid == request.auth.uid;

        // Sitz beanspruchen: nur als sich selbst, mit leerer Starthand (Plätze 1-3) oder direkt
        // mit der vollen Hand (der vierte Spieler mischt und legt seine eigene Hand im selben
        // Zug an, siehe joinTable() in lobby.js).
        allow create: if signedIn()
          && request.resource.data.claimedByUid == request.auth.uid
          && (request.resource.data.hand.size() == 0 || request.resource.data.hand.size() == 14);

        allow update: if signedIn() && (
          // eigene Hand fortlaufend aktualisieren (z. B. beim Ausspielen von Karten)
          resource.data.claimedByUid == request.auth.uid
          ||
          // einmaliges Austeilen durch den Mitspieler, der den vierten Sitz füllt: darf nur
          // das `hand`-Feld setzen, und nur solange die Hand noch leer (also nicht ausgeteilt) ist.
          // (Kein isParticipant()-Check hier, aus demselben Transaktions-Sichtbarkeitsgrund wie
          // oben - Restrisiko ist dokumentiert in der README.)
          (resource.data.hand.size() == 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hand']))
        );

        // Verlassen: nur die eigene private Hand darf gelöscht werden, damit der Sitz danach
        // frisch (per create()) neu beansprucht werden kann.
        allow delete: if signedIn() && resource.data.claimedByUid == request.auth.uid;
      }

      // Ereignis-Log der gespielten Züge (einmal gespielte Karten sind ohnehin öffentlich).
      match /events/{eventId} {
        allow read: if signedIn();
        allow create: if signedIn() && isParticipant(gameId);
        allow update, delete: if false;
      }
    }
  }
}
